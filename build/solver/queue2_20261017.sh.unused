#!/bin/zsh
# 2026-10-17 replaces restart_queue_20261017.sh after req_jj_sitton (Paul: fewer elementary->high splits for James John).
# Waits for the running req_jj_sitton_chz solve, smooths it, then req_jj_sitton_nest, then the rest in the same order.
cd "$(dirname "$0")"; PY=../../.venv/bin/python
while pgrep -f "solve.py configs/v2/req_jj_sitton_chz.json" >/dev/null; do sleep 30; done
echo "== req_jj_sitton_chz finished $(date +%T)"
[ -f out_v2/req_jj_sitton_chz.staging/scorecard.json ] && $PY smooth_v2.py req_jj_sitton_chz --src staging 2>&1 | tail -3
for n in req_jj_sitton_nest option2_ms415 option3a_ms415 req_irv_open req_sabin_open req_irv_for_bc; do
  echo "== $n $(date +%T)"
  $PY -u solve.py configs/v2/$n.json > out_v2/_run_$n.log 2>&1 || echo "$n FAILED"
  [ -f out_v2/$n.staging/scorecard.json ] && $PY smooth_v2.py $n --src staging 2>&1 | tail -3
done
echo "== cap4_415 $(date +%T)"
WORKERS=8 ./capstone4.sh cap4_415 415 option2_ms460_long || echo "cap4_415 FAILED"
echo "== DONE $(date +%T)"
